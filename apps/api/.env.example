# Port this API listens on.
API_PORT=3002

# Port the auth issuer listens on. The issuer URL is derived from the request host and this
# port, so the API works locally and from another machine over a tailnet without extra config.
AUTH_PORT=3001

# Explicit issuer URL. Required in production; overrides the derived URL.
# AUTH_ISSUER=http://localhost:3001

# Extra browser origins allowed by CORS (comma-separated scheme://host).
# Defaults: reflect any origin in development, allow none in production.
# API_ALLOWED_ORIGINS=http://localhost:5173
