# Environment for the Rafiki API (apps/api). Copy to `.env`:
#
#   cp apps/api/.env.example apps/api/.env
#
# The API loads .env at startup. Values already set in the real environment win.
# Everything is optional in development: when a variable is unset, the default below is used.

# --- Auth issuer ------------------------------------------------------------

# Required in production. URL the API verifies Bearer tokens against.
# In development the issuer is derived from the request host and AUTH_PORT.
# AUTH_ISSUER=https://auth.example.gov.za

# Optional, default 3000. Port apps/auth listens on; used to derive the issuer URL.
# AUTH_PORT=3000

# --- HTTP server ------------------------------------------------------------

# Optional, default 3001. Port this API listens on.
# API_PORT=3001

# Optional. Browser origins allowed by CORS, comma-separated scheme://host.
# Default: reflect any origin in development, allow none in production.
# API_ALLOWED_ORIGINS=http://localhost:5173

# --- POPIA requests ---------------------------------------------------------

# Optional, default postgres://rafiki:rafiki@127.0.0.1:5432/rafiki_auth.
# The auth database also holds the POPIA request tables and the AI telemetry
# governance table (`ai_spans`); see apps/auth/auth/db/schema.ts.
# DATABASE_URL=postgres://rafiki:rafiki@127.0.0.1:5432/rafiki_auth

# --- Chat agent (OpenCode Go) -----------------------------------------------

# Optional. API key for the OpenCode Go provider. Without it the API still boots,
# but agent status reports the provider as unavailable and chats cannot run.
# OPENCODE_API_KEY=

# Optional, default muse-spark-1.3-contributor. Model id the agent requests.
# PI_MODEL=muse-spark-1.3-contributor

# --- RAG index --------------------------------------------------------------

# Optional, default postgres://rafiki:rafiki@127.0.0.1:5432/rafiki_rag.
# Postgres database holding the RAG index (needs the pgvector extension, which
# `vp run rag:ingest` enables). Kept separate from the auth database.
# RAG_DATABASE_URL=postgres://rafiki:rafiki@127.0.0.1:5432/rafiki_rag

# Optional, default ./corpus. Directory of source documents to index
# (.txt / .md / .json / .jsonl).
# RAG_CORPUS=corpus

# Optional, default ./models. Local cache for the embedding model.
# RAG_MODELS_DIR=models

# Optional, default Xenova/multilingual-e5-small. Embedding model id.
# RAG_MODEL=Xenova/multilingual-e5-small

# Optional, default 384. Embedding dimension; must match RAG_MODEL.
# RAG_EMBED_DIM=384

# Optional, default 16. Embedding batch size.
# RAG_EMBED_BATCH=16

# Optional, default 1200. Chunk size in characters.
# RAG_CHUNK_SIZE=1200

# Optional, default 160. Chunk overlap in characters.
# RAG_CHUNK_OVERLAP=160

# Optional, default 0.8. Minimum cosine similarity when the query contains a
# discriminative lexical term grounding it in the corpus.
# RAG_MIN_SIMILARITY=0.8

# Optional, default 0.86. Stricter threshold used when it does not.
# RAG_STRICT_SIMILARITY=0.86

# Optional, default 0.3. Terms appearing in more documents than this fraction
# are dropped from keyword search as non-discriminative.
# RAG_MAX_DF_RATIO=0.3

# Internal: set by the one-time `vp run rag:model` script, never by the server.
# RAG_ALLOW_DOWNLOAD=1
