# Environment for the Rafiki auth issuer (apps/auth). Copy to `.env`:
#
#   cp apps/auth/.env.example apps/auth/.env
#
# Bun loads .env automatically; auth/env.ts covers tools that run under Node (drizzle-kit).
# Values already set in the real environment win. Every variable is optional locally: the
# defaults below are used when a variable is unset.

# --- Server -----------------------------------------------------------------

# Optional, default 3000. Port the issuer listens on. apps/api and apps/website must use
# the same value as AUTH_PORT.
# AUTH_PORT=3000

# Optional. Extra OAuth redirect-URI origins the issuer accepts, as a comma-separated list
# of scheme://host. Clients on the same hostname as this server are allowed automatically;
# set this only for extra or proxied origins.
# AUTH_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---------------------------------------------------------------

# Optional, default postgres://rafiki:rafiki@127.0.0.1:5432/rafiki_auth.
# Connection string for the user store. Start Postgres with `vp run db:up`.
# DATABASE_URL=postgres://rafiki:rafiki@127.0.0.1:5432/rafiki_auth

# --- Storage (advanced) ------------------------------------------------------

# Optional. JSON read by OpenAuth that overrides the storage adapter, e.g.
# {"type":"memory"}. Leave unset in development so accounts survive restarts via
# .openauth-persist.json.
# OPENAUTH_STORAGE=

# --- Email ------------------------------------------------------------------

# Optional. SMTP used to send verification codes. With no SMTP_USER/SMTP_PASS, codes are
# printed to this process's console instead. The dev default is the local Mailpit catcher
# in docker-compose.yml (started by `vp run db:up`); read mail at http://localhost:8025.
# It works even on networks that block outbound SMTP. Mailpit accepts any credentials.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=rafiki
SMTP_PASS=rafiki
SMTP_FROM="Stats SA Rafiki <no-reply@statssa.gov.za>"

# Mailtrap sandbox, for networks that allow outbound SMTP.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=
