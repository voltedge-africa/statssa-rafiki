# Optional, auth server only. Extra origins accepted as OAuth redirect URIs, as a
# comma-separated list of scheme://host. Clients on the same hostname as this server are
# allowed automatically, so this is only needed for extra/proxied origins.
# AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://armomarchy.<tailnet>.ts.net:5173

# Optional. Port the issuer listens on. Must match AUTH_PORT used by the website (both 3001).
# AUTH_PORT=3001

# Postgres connection for the user store. Defaults to the docker-compose service below.
# Start it with `vp run auth#db:up` (from the repo root) or `vp run db:up` in apps/auth.
# DATABASE_URL=postgres://rafiki:rafiki@127.0.0.1:5432/rafiki_auth

# SMTP used to send verification codes. Without credentials, codes are printed to this
# process's console instead. Defaults suit a Mailtrap sandbox.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Stats SA Rafiki <no-reply@statssa.gov.za>"
