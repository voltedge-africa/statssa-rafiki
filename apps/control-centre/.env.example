# Environment for the control centre (apps/control-centre). Copy to `.env`:
#
#   cp apps/control-centre/.env.example apps/control-centre/.env
#
# Vite loads .env for both the client bundle and the server-side auth/proxy plugin. Every
# variable is optional: when unset, the issuer and website URLs are derived from the browser's
# hostname and the API is assumed to run on the local port.

# --- Auth -------------------------------------------------------------------

# Optional, default 3000. Port the auth issuer listens on. Used server-side to derive the
# issuer URL from the browser's hostname.
# AUTH_PORT=3000

# Optional. Explicit issuer URL. Set only for a proxy/HTTPS setup where deriving it from
# the browser hostname is not right.
# VITE_AUTH_ISSUER=http://localhost:3000

# --- API --------------------------------------------------------------------

# Optional, default http://localhost:3001. Base URL of the Rafiki API (apps/api). The control
# centre proxies /api/popia/* to this origin and attaches the session token.
# VITE_API_BASE=http://localhost:3001

# --- Website ----------------------------------------------------------------

# Optional, default: same hostname on port 3002. URL of the public website, linked from the
# control centre header.
# VITE_WEBSITE_URL=http://localhost:3002
