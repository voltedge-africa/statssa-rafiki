# Environment for the media room (apps/media-portal). Copy to `.env`:
#
#   cp apps/media-portal/.env.example apps/media-portal/.env
#
# Vite loads .env for both the client bundle and the server-side auth/proxy plugin. Every
# variable is optional: when unset, the issuer and sibling-app URLs are derived from the
# browser's hostname and the API is assumed to run on the local port.

# --- Auth -------------------------------------------------------------------

# Optional, default 3000. Port the auth issuer listens on. Used server-side to derive the
# issuer URL from the browser's hostname.
# AUTH_PORT=3000

# Optional. Explicit issuer URL. Set only for a proxy/HTTPS setup where deriving it from
# the browser hostname is not right.
# VITE_AUTH_ISSUER=http://localhost:3000

# --- API --------------------------------------------------------------------

# Optional, default http://localhost:3001. Base URL of the Rafiki API (apps/api). The media
# portal proxies /api/media/* to this origin and attaches the session token.
# VITE_API_BASE=http://localhost:3001

# --- Sibling apps -----------------------------------------------------------

# Optional, default: same hostname on port 3002. URL of the public website, linked from the
# media room footer.
# VITE_WEBSITE_URL=http://localhost:3002

# Optional, default: same hostname on port 3003. URL of the public chat portal, linked from
# the media room footer.
# VITE_PUBLIC_PORTAL_URL=http://localhost:3003

# Optional, default: same hostname on port 3006. URL of the Staff/Admin control centre,
# linked from the media room header for Staff and Admin accounts.
# VITE_CONTROL_CENTRE_URL=http://localhost:3006
