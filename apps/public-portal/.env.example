# Environment for the public chat portal (apps/public-portal). Copy to `.env`:
#
#   cp apps/public-portal/.env.example apps/public-portal/.env
#
# Vite loads .env and inlines VITE_-prefixed values at build time. The variable below is
# optional: when unset, the local API default is used.

# Optional, default http://localhost:3001. Base URL of the Rafiki agent API (apps/api).
# VITE_API_BASE=http://localhost:3001
