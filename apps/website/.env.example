# Environment for the website (apps/website). Copy to `.env`:
#
#   cp apps/website/.env.example apps/website/.env
#
# Vite loads .env for both the client bundle and the server-side auth plugin. Values already
# set in the real environment win. Every variable is optional: when unset, the issuer and
# portal URLs are derived from the hostname the browser used.

# --- Auth -------------------------------------------------------------------

# Optional, default 3000. Port the auth issuer listens on. Used server-side to derive the
# issuer URL from the browser's hostname.
# AUTH_PORT=3000

# Optional. Explicit issuer URL. Set only for a proxy/HTTPS setup where deriving it from
# the browser hostname is not right.
# VITE_AUTH_ISSUER=http://localhost:3000

# --- Public chat portal -----------------------------------------------------

# Optional, default: same hostname on port 3003. URL of the public chat portal; set this to
# the deployed portal URL in production.
# VITE_PUBLIC_PORTAL_URL=http://localhost:3003

# --- API --------------------------------------------------------------------

# Optional, default http://localhost:3001. Base URL of the Rafiki API (apps/api). The website
# proxies /api/popia/* to this origin and attaches the session token.
# VITE_API_BASE=http://localhost:3001

# --- Control centre ---------------------------------------------------------

# Optional, default: same hostname on port 3006. URL of the control centre (Staff/Admin
# workspace); sign-in redirects Staff and Admin there.
# VITE_CONTROL_CENTRE_URL=http://localhost:3006

# --- Media room -------------------------------------------------------------

# Optional, default: same hostname on port 3004. URL of the media room (Press workspace);
# sign-in redirects Press there.
# VITE_MEDIA_PORTAL_URL=http://localhost:3004
