# Optional. URL of the auth server (apps/auth). When unset, the website derives the issuer from
# the hostname the browser used (same host, port 3001). That covers both local development
# (http://localhost:5173) and access from another tailnet machine
# (http://armomarchy.<tailnet>.ts.net:5173) without any config.
# Set this only for a proxy/HTTPS setup where that derivation is not right.
# VITE_AUTH_ISSUER=http://localhost:3001
