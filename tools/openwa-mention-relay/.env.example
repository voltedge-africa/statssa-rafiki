# OpenWA mention relay — environment (all optional).
#
# `npm start` loads this as `.env` if present (node --env-file-if-exists). The defaults target the
# local dev stack (OpenWA on 2785, API on 3001); copy to `.env` to override.
#
#   cp .env.example .env

# --- OpenWA gateway ---------------------------------------------------------

# Base URL of the OpenWA gateway.
# OPENWA_BASE_URL=http://localhost:2785

# The OpenWA session (WhatsApp device) to listen on. Find it with:
#   curl -H "X-API-Key: <key>" http://localhost:2785/api/sessions
# OPENWA_SESSION_ID=

# The group to watch. A group id looks like 12036...@g.us.
# OPENWA_GROUP_ID=

# WIDs that count as "the bot was tagged". Comma-separated. Include the bot's phone WID and its
# privacy-id (LID) form if it appears as @lid in the group.
# OPENWA_BOT_WIDS=27729332671@c.us,19555623690423@lid

# Per-chat floor between replies, in milliseconds (collapses bursts).
# OPENWA_MIN_REPLY_GAP_MS=2000

# --- OpenWA API credential --------------------------------------------------

# Master/first-boot API key. If unset, the relay tries OPENWA_KEY_FILE, the bind-mounted
# OpenWA/data/.api-key, and finally `docker exec <container> cat /app/data/.api-key`.
# OPENWA_API_KEY=

# Explicit path to the gateway's .api-key file.
# OPENWA_KEY_FILE=/path/to/OpenWA/data/.api-key

# Container name used for the docker-exec fallback.
# OPENWA_CONTAINER=openwa-api

# --- Rafiki AI API ----------------------------------------------------------

# Base URL of the Rafiki API (apps/api).
# OPENWA_AI_URL=http://localhost:3001

# Set to false to disable the AI and echo the (tag-stripped) message instead of answering.
# OPENWA_AI_ENABLED=true

# Conversation scope: `sender` (a separate thread per person) or `group` (one shared thread).
# OPENWA_AI_SESSION_SCOPE=sender

# Request timeout for /api/chat/final, in milliseconds.
# OPENWA_AI_TIMEOUT_MS=120000

# Keep inline citation markers ([source#12], [factstore:table]) instead of stripping them.
# OPENWA_AI_KEEP_CITATIONS=false
